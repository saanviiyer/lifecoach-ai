# Copy this file to .env and fill in your key to use the real Anthropic API.
# If ANTHROPIC_API_KEY is left unset, the app runs in MOCK MODE:
# it returns a realistic templated roadmap and canned coach replies, with zero setup.
ANTHROPIC_API_KEY=

# Optional: port the backend (Express + WebSocket) listens on. Defaults to 3001.
PORT=3001
